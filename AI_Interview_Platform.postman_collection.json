              "raw": "{{baseUrl}}/ai-interview/sessions/{{user_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ai-interview",
                "sessions",
                "{{user_id}}"
              ]
            }
          }
        },
        {
          "name": "Create Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"Backend Engineer\",\n  \"industry\": \"Software\",\n  \"company\": \"Acme Corp\",\n  \"cv_file_id\": \"cv123\",\n  \"jd_file_id\": \"jd456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ai-interview/session/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ai-interview",
                "session",
                "create"
              ]
            }
          }
        },
        {
          "name": "Get Next Question",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ai-interview/session/{{session_id}}/next-question",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ai-interview",
                "session",
                "{{session_id}}",
                "next-question"
              ]
            }
          }
        }
      ]
    },
