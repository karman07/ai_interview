{
  "info": {
    "name": "AI Interview Platform - Complete API Collection",
    "_postman_id": "ai-interview-platform-2026",
    "description": "Complete API collection for AI Interview Platform including WebSocket events, REST endpoints, Authentication, Resume, and Interview Rounds",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "session_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', jsonData.access_token);",
                  "    pm.collectionVariables.set('user_id', jsonData.user._id || jsonData.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Register",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"Test User\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "AI Interview API Integration",
      "item": [
        {
          "name": "Start Interview Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.session_id || jsonData.sessionId) {",
                  "        pm.collectionVariables.set('session_id', jsonData.session_id || jsonData.sessionId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{user_id}}\",\n  \"session_id\": \"session-{{$timestamp}}\",\n  \"role_title\": \"Backend Engineer\",\n  \"company_name\": \"Acme Corp\",\n  \"industry\": \"Software\",\n  \"jd\": \"Design and develop microservices using Node.js and TypeScript\",\n  \"cv\": \"Experienced backend engineer with 5 years in Node.js\",\n  \"round_type\": \"technical\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ai-interview/start",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ai-interview",
                "start"
              ]
            }
          }
        },
        {
          "name": "Submit Answer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{user_id}}\",\n  \"session_id\": \"{{session_id}}\",\n  \"answer\": \"My answer is to use async/await patterns with proper error handling and implement circuit breakers for external service calls.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ai-interview/answer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ai-interview",
                "answer"
              ]
            }
          }
        },
        {
          "name": "Get Interview State",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ai-interview/state/{{user_id}}/{{session_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ai-interview",
                "state",
                "{{user_id}}",
                "{{session_id}}"
              ]
            }
          }
        },
        {
          "name": "Get Interview Report",
          "request": {
